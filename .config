CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y
CONFIG_IMAGE_SIZE="27328k"

# Base system
CONFIG_BASE_FILES=y
CONFIG_BLOCK_MOUNT=y
CONFIG_BUSYBOX=y
CONFIG_CA_BUNDLE=y
CONFIG_DNSMASQ_FULL=y
CONFIG_DROPBEAR=y
CONFIG_FIREWALL=y
CONFIG_FSTOOLS=y
CONFIG_IPTABLES=y
CONFIG_IPV6HELPER=y
CONFIG_OPKG=y
CONFIG_PPP=y
CONFIG_PPP_MOD_PPPOE=y
CONFIG_PROCD=y
CONFIG_UCI=y
CONFIG_WPAD_OPENSSL=y

# Kernel modules eMMC驱动（核心，解决你之前I/O报错）
CONFIG_KMOD_MMC=y
CONFIG_KMOD_MMC_MTK=y
CONFIG_KMOD_MMC_SPI=y
CONFIG_KMOD_USB3=y
CONFIG_KMOD_MT7603=y
CONFIG_KMOD_MT7615E=y
CONFIG_KMOD_MT7615_FIRMWARE=y
CONFIG_KMOD_IPT_RAW=y

# 磁盘工具 内置fdisk parted e2fsprogs，刷完直接可用
CONFIG_PARTED=y
CONFIG_E2FSPROGS=y
CONFIG_FDISK=y

# LuCI核心
CONFIG_LUCI=y
CONFIG_LUCI_COMPAT=y
CONFIG_LUCI_THEME_ARGON=y

# LuCI插件 你需要的全套
CONFIG_LUCI_APP_OPENCLASH=y
CONFIG_LUCI_APP_V2RAYA=y
CONFIG_LUCI_APP_DDNSTO=y
CONFIG_LUCI_APP_TIMEWOL=y
CONFIG_LUCI_APP_SAMBA4=y
CONFIG_LUCI_APP_FILETRANSFER=y
CONFIG_LUCI_APP_DISKMAN=y
# eMMC SDHCI驱动 京东云RE-SP-01B
CONFIG_KMOD_SDHCI=y
CONFIG_KMOD_SDHCI_MT7620=y
CONFIG_KMOD_MMC_BLOCK=y
CONFIG_KMOD_FS_EXT4=y
